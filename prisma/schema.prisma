generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  password    String
  name        String?
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MemberProfile {
  id                      String               @id @default(cuid())
  employeeId              String?
  department              String?
  workspaceRole           String?
  name                    String
  gender                  String?
  birthDate               DateTime?
  ethnicity               String?
  hometown                String?
  politicalStatus         String?
  partyAge                String?
  partyRole               String?
  academicTitle           String?
  mentorType              String?
  researchDirection       String?
  workStartDate           DateTime?
  schoolEntryDate         DateTime?
  highestDegree           String?
  biography               String?
  talentPrograms          String?
  majorProjects           String?
  talentTitles            String?
  provincialAwards        String?
  socialPartTime          String?
  idNumber                String?
  phone                   String?
  wechat                  String?
  email                   String?
  maritalStatus           String?
  spouseChildren          String?
  emergencyContact        String?
  hobbies                 String?
  partyIntent             String               @default("待考虑")
  applicationSubmitted    Boolean              @default(false)
  developmentStage        String?
  politicalStudyNotes     String?
  democraticReviewNotes   String?
  ideologyAttachmentUrl   String?
  ideologyAttachmentName  String?
  avatarUrl               String?
  avatarName              String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  activities              ActivityRecord[]
  keyPerformances         KeyPerformance[]
  careerRecords           CareerRecord[]
  contacts                ContactPerson[]
  conversations           ConversationRecord[]
  issueSuggestions        IssueSuggestion[]
  changeRequests          ProfileChangeRequest[]
}

model ActivityRecord {
  id              String        @id @default(cuid())
  profileId       String
  date            DateTime?
  title           String
  category        String?
  description     String?
  attachmentUrl   String?
  attachmentName  String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model KeyPerformance {
  id              String        @id @default(cuid())
  profileId       String
  date            DateTime?
  title           String
  description     String?
  externalLink    String?
  attachmentUrl   String?
  attachmentName  String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model CareerRecord {
  id              String        @id @default(cuid())
  profileId       String
  date            DateTime?
  title           String
  description     String?
  attachmentUrl   String?
  attachmentName  String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ContactPerson {
  id          String        @id @default(cuid())
  profileId   String
  role        String
  name        String?
  title       String?
  talentTitle String?
  note        String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  profile     MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ConversationRecord {
  id              String        @id @default(cuid())
  profileId       String
  date            DateTime?
  interviewer     String?
  location        String?
  summary         String
  confusion       String?
  actionPlan      String?
  attachmentUrl   String?
  attachmentName  String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model IssueSuggestion {
  id              String        @id @default(cuid())
  profileId       String
  type            String
  title           String
  specificIssues  String?
  needs           String?
  status          String?
  attachmentUrl   String?
  attachmentName  String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ProfileChangeRequest {
  id              String        @id @default(cuid())
  profileId       String
  requesterId     String
  requesterName   String
  status          String        @default("pending") // pending, approved, rejected
  originalData    String        // JSON string of the original MemberDraft
  snapshotData    String        // JSON string of the modified MemberDraft
  rejectReason    String?
  createdAt       DateTime      @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  profile         MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model CollaborationNeed {
  id              String        @id @default(cuid())
  authorId        String        // employeeId of the author
  authorName      String
  department      String?
  title           String
  content         String
  requirements    String?
  status          String        @default("open") // open, closed
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
